# Copie para .env e ajuste se necessário. Todas as variáveis são opcionais.

# HTTP
HTTP_TIMEOUT_MS=10000
# User-Agent enviado às APIs públicas (Nominatim exige um UA identificável)
USER_AGENT=mcp-dados-brasil/0.1 (consulta local de dados publicos)

# Cache local (relativo à raiz do projeto ou caminho absoluto)
CACHE_DIR=data/cache
CACHE_TTL_CNPJ_DIAS=7
CACHE_TTL_IBGE_DIAS=30
# CACHE_DESATIVADO=1

# Limites de taxa
# Publica CNPJ.ws: 3 consultas/min → 20000 ms entre chamadas
CNPJWS_INTERVALO_MS=20000
# Nominatim (OSM): máx. 1 req/s
NOMINATIM_INTERVALO_MS=1100
# E-mail de contato opcional exigido pela política do Nominatim para uso frequente
NOMINATIM_EMAIL=

# Radar de site
SITE_RADAR_TIMEOUT_MS=5000
SITE_RADAR_MAX_BYTES=2097152

# ─── Banco (Etapa 2) — Supabase/PostgreSQL ───
# Pooler IPv4 em modo sessão (porta 5432). A senha fica SÓ no .env (nunca no git).
# DATABASE_URL=postgresql://postgres.jrihxhwtinaxhpfcuypw:[SUA-SENHA]@aws-0-us-east-2.pooler.supabase.com:5432/postgres
# Certificado CA do Supabase (Dashboard → Database → SSL Configuration → Download certificate).
# Com ele, o certificado do servidor é verificado; sem ele, a conexão é cifrada mas não verificada.
# DATABASE_SSL_CA=certs/prod-ca-2021.crt
# DATABASE_POOL_MAX=5
# DATABASE_TIMEOUT_MS=10000
# DB_MEMORIA=1   # usa PGlite em memória (testes/experimentos; exige devDependencies)
